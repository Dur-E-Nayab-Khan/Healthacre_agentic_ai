# Copy this file to .env in the same folder (backend/.env) and fill in your key.
# .env is loaded automatically by agents.py -- never commit the real .env file.

# Free key from Google AI Studio, no credit card required:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Optional: override the default model. gemini-2.5-flash is on the free tier
# as of writing; gemini-2.5-flash-lite has higher free-tier rate limits if
# you hit 429s. Check current limits at:
# https://ai.google.dev/gemini-api/docs/rate-limits
# HEALTHCARE_DEMO_MODEL=gemini-2.5-flash

# Optional: embedding model used by the file-based RAG demo (knowledge_rag.py)
# text-embedding-004 was fully shut down by Google -- gemini-embedding-001
# is the current model as of writing.
# HEALTHCARE_DEMO_EMBED_MODEL=models/gemini-embedding-001

# Optional: JWT signing secret (auth.py falls back to a dev default if unset)
# HEALTHCARE_DEMO_JWT_SECRET=change-me-to-something-random

# Optional: how long login tokens stay valid, in minutes. Defaults to 480
# (8 hours) for convenient local testing. Lower this (e.g. to 1 or 2) if you
# specifically want to test token-expiration handling.
# HEALTHCARE_DEMO_TOKEN_EXPIRE_MINUTES=480
